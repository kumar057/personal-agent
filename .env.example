# AI Engine Provider ('gemini', 'groq', or 'ollama')
AI_PROVIDER=gemini

# Google Gemini API Key (Get free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Optional: Groq Cloud API Key (Get free key from https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Local Ollama (Only needed if running 100% offline)
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_MODEL=llama3.2:3b

# Web Server
HOST=0.0.0.0
PORT=8000

# Optional: Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=
